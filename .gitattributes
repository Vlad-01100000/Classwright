# Normalize line endings: LF in the repository, native in the working tree by default.
* text=auto

# POSIX scripts must stay LF everywhere, or bash refuses them on the CI runners.
mvnw text eol=lf
*.sh text eol=lf

# The Windows wrapper script is read by cmd.exe, which wants CRLF.
mvnw.cmd text eol=crlf

# Binary evidence and archives.
*.jar binary
*.zip binary
